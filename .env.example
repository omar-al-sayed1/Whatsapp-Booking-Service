# Copy to .env (never committed) or set in the environment. See docs/SPEC.md section 7.
# The dev profile falls back to the compose database for the three DATABASE_* variables.

# JDBC URL, e.g. jdbc:postgresql://localhost:5432/clinicreminders
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# WhatsApp Cloud API
# App secret from the Meta app dashboard; signs every webhook (X-Hub-Signature-256)
WA_APP_SECRET=
# Any random string; enter the same value when registering the webhook URL with Meta
WA_VERIFY_TOKEN=
# Graph API version, e.g. v26.0 (current as of October 2026)
WA_GRAPH_VERSION=

# Base64-encoded 256-bit key for AES-GCM encryption of per-clinic access tokens
TOKEN_ENCRYPTION_KEY=

# E.164 number that receives operator alerts (M7)
OPERATOR_ALERT_PHONE=

# Public base URL, e.g. https://reminders.example.com
APP_BASE_URL=
